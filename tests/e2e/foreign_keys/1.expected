CREATE TABLE
Table "emp"
  id  INT  NOT NULL
  name  TEXT
  dept_id  INT
  boss  INT
  index emp_pkey (id) UNIQUE btree
  constraint emp_boss FOREIGN KEY (boss) REFERENCES emp(id) ON DELETE SET NULL
  constraint emp_dept_id_fkey FOREIGN KEY (dept_id) REFERENCES dept(id) ON DELETE CASCADE ON UPDATE CASCADE
  referenced by emp(boss) via emp_boss
Table "dept"
  id  INT  NOT NULL
  name  TEXT  NOT NULL
  index dept_pkey (id) UNIQUE btree
  referenced by emp(dept_id) via emp_dept_id_fkey
